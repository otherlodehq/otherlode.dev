// An assets-only Worker: Cloudflare serves the files in dist/ and runs no
// code, so public/_headers applies to every response.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otherlode-dev",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
