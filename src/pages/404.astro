---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
---

<Base title="Page not found" description="There's no page at this address." index={false} mainClass="flex flex-col">
  <section aria-labelledby="missing-title" class="flex flex-1 flex-col">
    <div class="mx-auto w-full max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
      <p class="font-mono text-[0.9375rem] text-signal-text">404</p>
      <h1 id="missing-title" class="display mt-3 max-w-[40rem] text-[clamp(2.5rem,7vw,4.5rem)]">
        This page never ran.
      </h1>
      <p class="mt-5 max-w-[34rem] text-muted-foreground">
        There's nothing at this address. The link may be wrong.
      </p>
      <p class="mt-8">
        <a href="/" class="button">Go to the homepage</a>
      </p>
    </div>
    <Ridge class="mt-auto h-16 sm:h-24 lg:h-32" />
  </section>
</Base>
