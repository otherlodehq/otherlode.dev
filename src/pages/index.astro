---
import Base from '../layouts/Base.astro';
import CodeLines, { type CodeLine } from '../components/CodeLines.astro';
import CodePathsFigure from '../components/CodePathsFigure.astro';
import ReplicasFigure from '../components/ReplicasFigure.astro';
import Ridge from '../components/Ridge.astro';
import { agentRepo, contactEmail, earlyAccessHref, earlyAccessMailto } from '../lib/site';

/** One row of a short list, such as an endpoint and its call count. A row with a verdict never ran. */
interface TallyRow {
  code: string;
  note?: string;
  verdict?: string;
}

/** One kind of finding, shown as a short list or as a few lines of code. */
interface Finding {
  title: string;
  file?: string;
  rows?: TallyRow[];
  lines?: CodeLine[];
}

const findings: Finding[] = [
  {
    title: 'Endpoint never called',
    rows: [
      { code: 'POST /orders', note: '18,204 calls' },
      { code: 'GET /orders/{id}', note: '52,911 calls' },
      { code: 'POST /promo', verdict: 'never called' },
    ],
  },
  {
    title: 'Method never hit',
    file: 'RefundService.kt',
    lines: [
      { n: 40, code: 'fun refund(order: Order)', note: '1,204 hits' },
      { n: 41, code: 'fun refund(order: Order, reason: String)', note: '318 hits' },
      { n: 58, code: 'fun refundLegacy(order: Order)', verdict: 'never hit', dead: true },
    ],
  },
  {
    title: 'Branch never taken',
    file: 'PricingService.kt',
    lines: [
      { n: 71, code: 'if (customer.isLegacy()) {', verdict: 'never true' },
      { n: 72, code: '    total = legacyDiscount(total)', dead: true },
      { n: 73, code: '}' },
      { n: 74, code: 'return total', note: '18,204 hits' },
    ],
  },
  {
    title: 'Class never used',
    rows: [
      { code: 'LegacyDiscount', verdict: 'never loaded' },
      { code: 'AuditLog', verdict: 'never initialised' },
      { code: 'ReceiptPrinter', verdict: 'never instantiated' },
    ],
  },
  {
    title: 'Dependency never used',
    rows: [
      { code: 'jackson-module-kotlin 2.17.1', note: '212 of 380 classes' },
      { code: 'kotlinx-coroutines-core 1.8.1', note: '96 of 1,140 classes' },
      { code: 'commons-csv 1.10.0', verdict: 'never loaded' },
    ],
  },
  {
    title: 'Called only by tests',
    file: 'CartService.kt',
    lines: [
      { n: 88, code: 'fun recalculate(cart: Cart)', verdict: '0 hits in production', dead: true },
      { code: '  run by CartTest.recalculatesTotals', muted: true },
      { code: '  run by CartTest.handlesEmptyCart', muted: true },
    ],
  },
];

const before: CodeLine[] = [
  { n: 1, code: 'fun checkout(cart: Cart) {' },
  { n: 2, code: '    if (flags.foo) {', verdict: 'never true', dead: true },
  { n: 3, code: '        bar(cart)', dead: true },
  { n: 4, code: '    }', dead: true },
  { n: 5, code: '    charge(cart)', note: '18,204 hits' },
  { n: 6, code: '}' },
  { n: 7, code: '' },
  { n: 8, code: 'fun bar(cart: Cart) = baz(cart)', verdict: 'only from line 3', dead: true },
  { n: 9, code: '', dead: true },
  { n: 10, code: 'fun baz(cart: Cart) {', verdict: 'only from line 8', dead: true },
  { n: 11, code: '    ...', dead: true },
  { n: 12, code: '}', dead: true },
];

const after: CodeLine[] = [
  { n: 1, code: 'fun checkout(cart: Cart) {' },
  { n: 2, code: '    charge(cart)' },
  { n: 3, code: '}' },
];

const security = [
  {
    title: 'Open source where it runs',
    body: 'The agent and collector are Apache 2.0.',
  },
  {
    title: 'String literals stay home',
    body: 'The collector can blank them out before reports leave your network.',
  },
  {
    title: 'Data in London',
    body: "Database and backups in Google Cloud's London region.",
  },
  {
    title: 'Your sign-in',
    body: 'Google, Microsoft, GitHub, or your own SAML or OIDC.',
  },
];
---

<Base>
  <section aria-labelledby="hero-title">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-12 lg:gap-14 lg:pt-20 lg:pb-20">
      <div class="lg:col-span-6 lg:self-center">
        <h1 id="hero-title" class="display text-[clamp(2.375rem,6vw,4.25rem)]">
          Traces find the motherlode. <span class="whitespace-nowrap">What about</span> the{' '}
          <span class="whitespace-nowrap"><span class="text-signal-text">other</span>lode?</span>
        </h1>
        <p class="mt-6 max-w-[32rem] text-[1.1875rem] leading-relaxed">
          <strong class="font-bold">Find the code that never runs in production</strong>, across every instance of your
          Java, Kotlin and Scala services.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
          <a href={earlyAccessHref} class="button">Ask for early access</a>
          <p class="text-[0.9375rem] text-muted-foreground">
            Or email <a href={earlyAccessMailto} class="underline">{contactEmail}</a>.
          </p>
        </div>
      </div>

      <figure class="box lg:col-span-6 lg:self-center">
        <div class="box-bar">
          <span class="tag">checkout</span>
          <span class="box-meta">6 replicas</span>
        </div>
        <CodePathsFigure />
      </figure>
    </div>
  </section>

  <section aria-labelledby="replicas-title" class="relative border-t-2 border-ink">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 pt-16 pb-12 sm:px-6 sm:pt-20 lg:grid-cols-[1fr_1.35fr] lg:gap-14">
      <div>
        <h2 id="replicas-title" class="display text-[clamp(2rem,4vw,3rem)]">Every replica, one answer.</h2>
        <p class="mt-4 max-w-[28rem] text-muted-foreground">
          Run the agent on every replica. Code only counts as never run when none of them ran it.
        </p>
      </div>
      <figure class="box">
        <ReplicasFigure />
      </figure>
    </div>
    <Ridge class="h-16 sm:h-24 lg:h-28" />
  </section>

  <section id="finds" aria-labelledby="finds-title" class="ground scroll-mt-4 bg-ground text-ground-foreground">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-20 sm:px-6 sm:pb-24">
      <h2 id="finds-title" class="display text-[clamp(2rem,4vw,3rem)]">What it finds</h2>

      <div class="mt-8 grid grid-cols-1 gap-7 lg:grid-cols-2">
        {
          findings.map((finding) => (
            <div class="box min-w-0">
              <div class="box-bar">
                <h3 class="tag">{finding.title}</h3>
                {finding.file && <code class="box-meta">{finding.file}</code>}
              </div>
              {finding.rows && (
                <ul class="tally">
                  {finding.rows.map((row) => (
                    <li class:list={{ 'never-ran': row.verdict }}>
                      <code>{row.code}</code>
                      <span class:list={{ 'font-bold text-signal-text': row.verdict }}>{row.verdict ?? row.note}</span>
                    </li>
                  ))}
                </ul>
              )}
              {finding.lines && <CodeLines lines={finding.lines} />}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="cut-title" class="border-t-2 border-ink">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="cut-title" class="display text-[clamp(2rem,4vw,3rem)]">Delete it in one go.</h2>
      <p class="mt-4 max-w-[34rem] text-muted-foreground">Everything behind a branch that never runs, grouped together.</p>

      <div class="mt-8 grid grid-cols-1 items-start gap-7 lg:grid-cols-2">
        <div class="box min-w-0">
          <div class="box-bar">
            <span class="tag">Before</span>
            <code class="box-meta">Checkout.kt</code>
          </div>
          <CodeLines lines={before} />
        </div>
        <div class="box min-w-0">
          <div class="box-bar">
            <span class="tag">After</span>
            <span class="box-meta">9 lines fewer</span>
          </div>
          <CodeLines lines={after} />
        </div>
      </div>
    </div>
  </section>

  <section id="how" aria-labelledby="how-title" class="scroll-mt-4 border-t-2 border-ink bg-muted">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="how-title" class="display text-[clamp(2rem,4vw,3rem)]">How it works</h2>

      <div class="flow mt-12">
        <div class="flow-zone"><span class="tag">Your network</span></div>
        <div class="flow-node col-start-1">
          <div class="box">
            <div class="box-bar"><span class="tag">Agent</span><span class="box-meta">In your JVM</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">
              Counts what runs. Attach it with <code class="whitespace-nowrap text-[0.9em]">-javaagent</code>.
            </p>
          </div>
        </div>
        <div class="flow-wire col-start-2">
          <svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 H88" fill="none" stroke="currentColor" stroke-width="3" />
            <path d="M84 1 L99 8 L84 15 Z" fill="currentColor" />
          </svg>
          <span>counts</span>
        </div>
        <div class="flow-node col-start-3">
          <div class="box">
            <div class="box-bar"><span class="tag">Collector</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">Gathers counts from every agent. Can blank out string literals.</p>
          </div>
        </div>
        <div class="flow-wire col-start-4">
          <svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 H88" fill="none" stroke="currentColor" stroke-width="3" />
            <path d="M84 1 L99 8 L84 15 Z" fill="currentColor" />
          </svg>
          <span>counts</span>
        </div>
        <div class="flow-node col-start-5">
          <div class="box">
            <div class="box-bar"><span class="tag">Otherlode</span><span class="box-meta">Hosted</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">Merges every replica and shows what never ran.</p>
          </div>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_1.4fr]">
        <p>
          No release yet, so build the jar from the <a href={agentRepo} class="underline">agent's repo</a> with{' '}
          <code class="whitespace-nowrap text-[0.9em]">./gradlew build</code>.
        </p>
        <figure class="terminal min-w-0">
          <figcaption class="terminal-bar">
            <span>Run the agent</span>
            <span class="terminal-lights" aria-hidden="true"><span></span><span></span><span></span></span>
          </figcaption>
          <pre><code><span class="prompt" aria-hidden="true">$ </span>OTHERLODE_SERVICE_NAME=checkout \
  OTHERLODE_INCLUDE_PACKAGES=com.acme.checkout \
  OTHERLODE_ENDPOINT=http://&lt;your-collector&gt;:4319 \
  OTHERLODE_STATIC_BASELINE_ENABLED=true \
  java -javaagent:otherlode-agent-&lt;version&gt;.jar -jar app.jar</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <section id="security" aria-labelledby="security-title" class="scroll-mt-4 border-t-2 border-ink">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="security-title" class="display text-[clamp(2rem,4vw,3rem)]">Security and hosting</h2>
      <div class="box mt-8">
        <div class="box-bar" aria-hidden="true"></div>
        <dl class="spec">
          {
            security.map((item) => (
              <div>
                <dt class="font-extrabold">{item.title}</dt>
                <dd class="mt-1 text-[0.9375rem] text-muted-foreground">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section aria-labelledby="access-title" class="hatched border-y-2 border-ink">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="box">
        <div class="box-bar" aria-hidden="true"></div>
        <div class="flex flex-col items-start justify-between gap-6 p-6 sm:p-7 md:flex-row md:items-center">
          <h2 id="access-title" class="display text-[clamp(1.75rem,3.4vw,2.5rem)]">We're in early access.</h2>
          <a href={earlyAccessHref} class="button shrink-0">Ask for early access</a>
        </div>
      </div>
    </div>
  </section>
</Base>
