---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
import { agentRepo, collectorRepo, contactEmail, earlyAccessHref } from '../lib/site';

/**
 * One kind of finding, with optional examples from the agent's demo app.
 * Text in backticks in `body` renders as code.
 */
interface Finding {
  title: string;
  body: string;
  examples?: { code: string; verdict: string }[];
}

/** Splits text on backticks so the quoted parts can render as code. */
function withCode(text: string): { text: string; code: boolean }[] {
  return text.split('`').map((part, i) => ({ text: part, code: i % 2 === 1 }));
}

const findings: Finding[] = [
  {
    title: 'Endpoints nobody calls',
    body: "Routes your service exposes that no request has ever hit. Works with Spring MVC, Ktor, JAX-RS and the JDK's built-in HttpServer.",
    examples: [{ code: '/promo', verdict: 'never called' }],
  },
  {
    title: 'Methods that never run',
    body: "Methods no instance has ever run. Constructors only show up when they're an unused overload, one that never ran while another did, so you won't wade through every private constructor.",
    examples: [{ code: 'constructor(pounds: Int, pence: Int)', verdict: 'unused overload' }],
  },
  {
    title: 'Branches that only go one way',
    body: "An `if` or `switch` where one outcome has never happened. You get the condition the code checked, plus the lines only that outcome would have reached.",
    examples: [{ code: 'discounted > 100.0', verdict: 'was never true' }],
  },
  {
    title: 'Classes that never loaded',
    body: "Switch on the startup scan and Otherlode can name classes that never even loaded. It also catches the ones that loaded but never ran their initialiser, or never had an instance made.",
    examples: [
      { code: 'PromoRepository', verdict: 'never loaded' },
      { code: 'AuditLog', verdict: 'never initialised' },
      { code: 'ReceiptPrinter', verdict: 'never instantiated' },
    ],
  },
  {
    title: 'Dependencies you might not need',
    body: "Jars on your classpath that never loaded a class, or that your code never refers to. Treat these as leads, not verdicts: reflection and service loaders can still use a jar quietly.",
  },
  {
    title: 'Default parameters nobody changes',
    body: "Kotlin and Scala parameters with a default value. If no call ever passes one, you can drop the parameter. If every call passes it, the default's doing nothing.",
  },
  {
    title: 'Dead code behind one branch',
    body: "When a branch never goes one way, Otherlode gathers up the methods and classes that only that path leads to. Delete that side of the condition and the whole lot goes with it.",
  },
  {
    title: 'Code only your tests call',
    body: "Run the agent in your test JVM too, and Otherlode names the tests that still call code production never touches.",
  },
];

const security = [
  {
    title: 'Open source on your side',
    body: "The agent and collector are open source under Apache 2.0, so you can read every line that runs in your network.",
  },
  {
    title: 'Keep string literals at home',
    body: "The collector can blank out the string literals in your conditions before anything leaves your network, either all of them or just the ones matching your patterns. It's off by default, and a hash of each literal still travels in the report's keys.",
  },
  {
    title: 'Data in London',
    body: "Otherlode's database and backups live in Google Cloud's London region (europe-west2).",
  },
  {
    title: 'Sign in your way',
    body: "Your team signs in with Google, Microsoft or GitHub, or through your own SAML or OIDC single sign-on.",
  },
];
---

<Base>
  <section aria-labelledby="hero-title" class="relative">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 pt-14 pb-10 sm:px-6 sm:pt-20 lg:grid-cols-12 lg:gap-10 lg:pt-24 lg:pb-14">
      <div class="lg:col-span-7">
        <h1 id="hero-title" class="display text-[clamp(2.75rem,8.5vw,5.25rem)]">
          Find the code that never runs in production.
        </h1>
        <p class="mt-6 max-w-[34rem] text-[1.1875rem] leading-relaxed text-muted-foreground">
          Otherlode keeps count of what your Java, Kotlin and Scala services actually run in production. Leave it
          running for a few weeks across every instance, and it'll show you what never did: endpoints nobody
          calls, methods nobody hits, and branches that never go the other way.
        </p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
          <a href={earlyAccessHref} class="button">Ask for early access</a>
          <p class="text-[0.9375rem] text-muted-foreground">
            It's early days. Email <a href={`mailto:${contactEmail}`} class="underline">{contactEmail}</a> and we'll get you set up.
          </p>
        </div>
      </div>

      <figure class="self-end lg:col-span-5">
        <div class="rounded-xl border bg-card p-5 sm:p-6">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="chip-never">Never hit</span>
            <span class="text-[0.9375rem]">
              <code class="text-[0.875rem]">handleCheckout</code>{' '}
              <span class="text-muted-foreground">in</span>{' '}
              <code class="text-[0.875rem] text-muted-foreground">DemoServerMain.kt:71</code>
            </span>
          </div>
          <p class="mt-4 text-[0.9375rem] leading-relaxed">
            <code class="rounded bg-muted px-1.5 py-0.5 text-[0.8125rem] [overflow-wrap:anywhere] sm:text-[0.875rem]">System.getenv("ENABLE_LEGACY_DISCOUNT") == "true"</code>{' '}
            <span class="font-semibold text-signal-text">was never true.</span>{' '}
            <span class="text-muted-foreground">
              It's the only way to reach <code class="text-[0.8125rem]">DemoServerMain.kt:72</code>.
            </span>
          </p>
          <div class="mt-5 border-t pt-4">
            <p class="text-[0.875rem] text-muted-foreground">Delete that side of the <code class="text-[0.8125rem]">if</code> and these go with it:</p>
            <ul class="mt-2 space-y-1.5 text-[0.9375rem]">
              <li class="flex flex-wrap justify-between gap-x-4">
                <code class="text-[0.8125rem] sm:text-[0.875rem]">LegacyDiscountCalculator</code>
                <span class="text-muted-foreground">never loaded</span>
              </li>
              <li class="flex flex-wrap justify-between gap-x-4">
                <code class="text-[0.8125rem] sm:text-[0.875rem]">LegacyRates</code>
                <span class="text-muted-foreground">never loaded</span>
              </li>
            </ul>
          </div>
        </div>
        <figcaption class="mt-3 text-[0.875rem] text-muted-foreground">
          A real finding from the demo app in the agent's repo.
        </figcaption>
      </figure>
    </div>
    <Ridge class="h-24 sm:h-28 lg:h-40" />
  </section>

  <section id="finds" aria-labelledby="finds-title" class="ground scroll-mt-4 bg-ground text-ground-foreground">
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-20 sm:px-6 sm:pt-12 sm:pb-24">
      <div class="max-w-[40rem]">
        <h2 id="finds-title" class="heading text-[clamp(2rem,5vw,3rem)]">What it finds</h2>
        <p class="mt-4 text-ground-muted">
          Otherlode looks at your whole fleet before it calls anything dead. Code only counts as unused if none of
          the instances you're looking at ran it, so one quiet server won't get your code flagged.
        </p>
      </div>

      <ul class="mt-12 grid grid-cols-1 gap-x-12 sm:grid-cols-2">
        {
          findings.map((finding) => (
            <li class="border-t border-ground-border py-6">
              <h3 class="text-[1.1875rem] font-semibold leading-snug">{finding.title}</h3>
              <p class="mt-2 max-w-[36rem] text-ground-muted">
                {withCode(finding.body).map((part) => (part.code ? <code class="text-[0.9em]">{part.text}</code> : part.text))}
              </p>
              {finding.examples && (
                <ul class="mt-3 space-y-1 text-[0.9375rem]">
                  {finding.examples.map((example) => (
                    <li>
                      <code class="text-[0.875rem]">{example.code}</code>{' '}
                      <span class="text-ground-signal-text">{example.verdict}</span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-[0.875rem] text-ground-muted">
        Every example here is a real finding from the demo app in the{' '}
        <a href={agentRepo} class="underline">agent's repo</a>.
      </p>
    </div>
  </section>

  <section id="how" aria-labelledby="how-title" class="scroll-mt-4">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="max-w-[40rem]">
        <h2 id="how-title" class="heading text-[clamp(2rem,5vw,3rem)]">How it works</h2>
        <p class="mt-4 text-muted-foreground">
          Two open source pieces run inside your network and send us counts. We turn those counts into findings.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="rounded-xl border-2 border-dashed p-5 sm:p-6 lg:col-span-2">
          <h3 class="text-[0.9375rem] font-semibold text-muted-foreground">In your network</h3>
          <ol class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-6">
            <li class="flex gap-4">
              <span class="heading text-[2rem] leading-none text-muted-foreground" aria-hidden="true">1</span>
              <div class="min-w-0">
                <h4 class="text-[1.1875rem] font-semibold">The agent</h4>
                <p class="mt-2">
                  A jar you attach to your app with <code class="whitespace-nowrap text-[0.9em]">-javaagent</code>. It counts which
                  methods, endpoints and branches run, and sends the totals to your collector, every 60 seconds by
                  default. Switch on the startup scan and it'll spot classes that never load, too.
                </p>
                <p class="mt-3 text-[0.9375rem]">
                  <a href={agentRepo} class="underline">otherlode-agent on GitHub</a>
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="heading text-[2rem] leading-none text-muted-foreground" aria-hidden="true">2</span>
              <div class="min-w-0">
                <h4 class="text-[1.1875rem] font-semibold">The collector</h4>
                <p class="mt-2">
                  A server you run in your own network. It gathers up the agents' reports and passes them on to
                  Otherlode with your API key.
                </p>
                <p class="mt-3 text-[0.9375rem]">
                  <a href={collectorRepo} class="underline">otherlode-collector on GitHub</a>
                </p>
              </div>
            </li>
          </ol>
          <figure class="mt-8 min-w-0 border-t border-dashed pt-6">
            <figcaption class="text-[0.9375rem] text-muted-foreground">
              To attach the agent, tell it the service's name, which packages to watch and where your collector
              lives. The last line switches on the startup scan, which you'll need for never-loaded classes.
            </figcaption>
            <pre class="mt-3 overflow-x-auto rounded-lg bg-muted px-4 py-3 text-[0.8125rem] leading-relaxed"><code>OTHERLODE_SERVICE_NAME=checkout \
OTHERLODE_INCLUDE_PACKAGES=com.acme.checkout \
OTHERLODE_ENDPOINT=http://&lt;your-collector&gt;:4319 \
OTHERLODE_STATIC_BASELINE_ENABLED=true \
java -javaagent:otherlode-agent-&lt;version&gt;.jar -jar app.jar</code></pre>
            <p class="mt-3 text-[0.9375rem] text-muted-foreground">
              There's no published release yet, so build the jar from the{' '}
              <a href={agentRepo} class="underline">agent's repo</a> with{' '}
              <code class="whitespace-nowrap text-[0.9em]">./gradlew build</code>.
            </p>
          </figure>
        </div>

        <div class="self-start rounded-xl border bg-card p-5 sm:p-6">
          <h3 class="text-[0.9375rem] font-semibold text-muted-foreground">Hosted by Otherlode</h3>
          <ol start="3" class="mt-4">
            <li class="flex gap-4">
              <span class="heading text-[2rem] leading-none text-muted-foreground" aria-hidden="true">3</span>
              <div class="min-w-0">
                <h4 class="text-[1.1875rem] font-semibold">Otherlode</h4>
                <p class="mt-2">
                  Merges the reports from every instance of a service over weeks, and shows you the findings in a
                  web UI.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section id="security" aria-labelledby="security-title" class="scroll-mt-4 border-t">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="security-title" class="heading max-w-[40rem] text-[clamp(2rem,5vw,3rem)]">Security and hosting</h2>
      <dl class="mt-10 grid grid-cols-1 gap-x-12 gap-y-8 sm:grid-cols-2">
        {
          security.map((item) => (
            <div>
              <dt class="text-[1.1875rem] font-semibold leading-snug">{item.title}</dt>
              <dd class="mt-2 max-w-[36rem] text-muted-foreground">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section aria-labelledby="access-title" class="border-t bg-muted">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="access-title" class="display max-w-[44rem] text-[clamp(2.25rem,6vw,3.75rem)]">
        We're in early access.
      </h2>
      <p class="mt-5 max-w-[36rem] text-muted-foreground">
        We're setting accounts up by hand for now, so there's no sign-up form. Tell us a bit about the JVM services
        you run and we'll take it from there.
      </p>
      <div class="mt-8">
        <a href={earlyAccessHref} class="button">Email {contactEmail}</a>
      </div>
    </div>
  </section>
</Base>
