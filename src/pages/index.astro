---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
import { agentRepo, contactEmail, earlyAccessHref, earlyAccessMailto } from '../lib/site';

/**
 * One kind of finding, with optional examples from the agent's demo app.
 * Text in backticks in `body` renders as code.
 */
interface Finding {
  title: string;
  body: string;
  examples?: { code: string; verdict: string }[];
}

/** Splits text on backticks so the quoted parts can render as code. */
function withCode(text: string): { text: string; code: boolean }[] {
  return text.split('`').map((part, i) => ({ text: part, code: i % 2 === 1 }));
}

const findings: Finding[] = [
  {
    title: 'Endpoint never called',
    body: "Routes no request has ever matched, in Spring MVC, Ktor, JAX-RS or the JDK's `HttpServer`.",
    examples: [{ code: '/promo', verdict: 'never called' }],
  },
  {
    title: 'Method never hit',
    body: "Methods no instance has run.",
    examples: [{ code: 'constructor(pounds: Int, pence: Int)', verdict: 'unused overload' }],
  },
  {
    title: 'Branch outcome never taken',
    body: "An `if` or `switch` outcome that has never happened, with the lines only it would reach.",
    examples: [{ code: 'discounted > 100.0', verdict: 'was never true' }],
  },
  {
    title: 'Class never loaded, initialised or instantiated',
    body: "Classes that never loaded, never initialised or never had an instance made.",
    examples: [
      { code: 'PromoRepository', verdict: 'never loaded' },
      { code: 'AuditLog', verdict: 'never initialised' },
      { code: 'ReceiptPrinter', verdict: 'never instantiated' },
    ],
  },
  {
    title: 'Unreached cluster',
    body: "Everything that only an untaken branch leads to, grouped so you can delete it in one go.",
  },
  {
    title: 'Dependency never loaded or referenced',
    body: "Jars that never loaded a class, or that your code never references.",
  },
  {
    title: 'Default always or never used',
    body: "Kotlin and Scala default parameters that no call overrides, or that every call does.",
  },
  {
    title: 'Called only by tests',
    body: "Code only your tests run, and which tests run it.",
  },
];

const security = [
  {
    title: 'Open source where it runs',
    body: "The agent and collector are Apache 2.0.",
  },
  {
    title: 'String literals stay home',
    body: "The collector can blank out string literals in your conditions before reports leave your network.",
  },
  {
    title: 'Data in London',
    body: "The database and backups live in Google Cloud's London region.",
  },
  {
    title: 'Your sign-in',
    body: "Google, Microsoft, GitHub, or your own SAML or OIDC single sign-on.",
  },
];
---

<Base>
  <section aria-labelledby="hero-title" class="relative">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 pt-12 pb-12 sm:px-6 sm:pt-16 lg:grid-cols-12 lg:gap-14 lg:pt-20 lg:pb-16">
      <div class="lg:col-span-7">
        <h1 id="hero-title" class="display text-[clamp(2.375rem,6vw,4.25rem)]">
          Traces find the motherlode. <span class="whitespace-nowrap">What about</span> the{' '}
          <span class="whitespace-nowrap"><span class="text-signal-text">other</span>lode?</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-[1.1875rem] leading-relaxed">
          <strong class="font-bold">Find the code that never runs in production.</strong>{' '}
          Otherlode tracks what your Java, Kotlin and Scala services actually run, across every instance, and
          shows you what never did.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
          <a href={earlyAccessHref} class="button">Ask for early access</a>
          <p class="text-[0.9375rem] text-muted-foreground">
            Or email <a href={earlyAccessMailto} class="underline">{contactEmail}</a>.
          </p>
        </div>
      </div>

      <figure class="lg:col-span-5 lg:self-center">
        <div class="box">
          <div class="box-bar">
            <span class="tag">Finding</span>
            <code class="box-meta">DemoServerMain.kt:71</code>
          </div>
          <div class="px-4 pt-4 pb-5 text-[0.9375rem] leading-relaxed sm:px-5">
            <p class="font-bold"><code class="text-[0.9375em]">handleCheckout</code></p>
            <dl>
              <div class="mt-3.5 border-t-2 border-muted pt-3">
                <dt class="text-[0.8125rem] font-extrabold text-muted-foreground">Branch outcome never taken</dt>
                <dd class="mt-1.5">
                  <code class="bg-muted px-1.5 py-0.5 text-[0.8125rem] [overflow-wrap:anywhere] sm:text-[0.875rem]">System.getenv("ENABLE_LEGACY_DISCOUNT") == "true"</code>{' '}
                  <span class="font-bold text-signal-text">was never true.</span>
                </dd>
              </div>
              <div class="mt-3.5 border-t-2 border-muted pt-3">
                <dt class="text-[0.8125rem] font-extrabold text-muted-foreground">Unreached code behind it</dt>
                <dd class="mt-1.5">
                  Only that outcome reaches <code class="text-[0.8125rem]">DemoServerMain.kt:72</code>, so it{' '}
                  <span class="font-bold text-signal-text">never runs.</span>
                </dd>
              </div>
              <div class="mt-3.5 border-t-2 border-muted pt-3">
                <dt class="text-[0.8125rem] font-extrabold text-muted-foreground">Classes that go with it</dt>
                <dd class="mt-1.5">
                  <ul class="space-y-1">
                    <li class="flex flex-wrap justify-between gap-x-4">
                      <code class="text-[0.8125rem] sm:text-[0.875rem]">LegacyDiscountCalculator</code>
                      <span class="font-bold text-signal-text">never loaded</span>
                    </li>
                    <li class="flex flex-wrap justify-between gap-x-4">
                      <code class="text-[0.8125rem] sm:text-[0.875rem]">LegacyRates</code>
                      <span class="font-bold text-signal-text">never loaded</span>
                    </li>
                  </ul>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </figure>
    </div>
    <Ridge class="h-16 sm:h-24 lg:h-28" />
  </section>

  <section id="finds" aria-labelledby="finds-title" class="ground scroll-mt-4 bg-ground text-ground-foreground">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-20 sm:px-6 sm:pb-24">
      <h2 id="finds-title" class="display text-[clamp(2rem,4vw,3rem)]">What it finds</h2>

      <div class="box mt-8">
        <div class="box-bar" aria-hidden="true"></div>
        <table class="findings-table">
          <thead>
            <tr>
              <th scope="col">Finding</th>
              <th scope="col">What it means</th>
              <th scope="col">Example</th>
            </tr>
          </thead>
          <tbody>
            {
              findings.map((finding) => (
                <tr>
                  <th scope="row">{finding.title}</th>
                  <td>
                    {withCode(finding.body).map((part) => (part.code ? <code class="text-[0.9em]">{part.text}</code> : part.text))}
                  </td>
                  <td>
                    {finding.examples && (
                      <ul class="space-y-1">
                        {finding.examples.map((example) => (
                          <li>
                            <code class="text-[0.875rem]">{example.code}</code>{' '}
                            <span class="font-bold text-signal-text">{example.verdict}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="how" aria-labelledby="how-title" class="scroll-mt-4">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 id="how-title" class="display text-[clamp(2rem,4vw,3rem)]">How it works</h2>

      <div class="flow mt-12">
        <div class="flow-zone"><span class="tag">Your network</span></div>
        <div class="flow-node col-start-1">
          <div class="box">
            <div class="box-bar"><span class="tag">Agent</span><span class="box-meta">In your JVM</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">
              Counts which methods, endpoints, branches and classes run, on every instance. Attach it with{' '}
              <code class="whitespace-nowrap text-[0.9em]">-javaagent</code>.
            </p>
          </div>
        </div>
        <div class="flow-wire col-start-2">
          <svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 H88" fill="none" stroke="currentColor" stroke-width="3" />
            <path d="M84 1 L99 8 L84 15 Z" fill="currentColor" />
          </svg>
          <span>counts</span>
        </div>
        <div class="flow-node col-start-3">
          <div class="box">
            <div class="box-bar"><span class="tag">Collector</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">
              Gathers counts from every agent. Can blank out string literals before anything leaves your network.
            </p>
          </div>
        </div>
        <div class="flow-wire col-start-4">
          <svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 H88" fill="none" stroke="currentColor" stroke-width="3" />
            <path d="M84 1 L99 8 L84 15 Z" fill="currentColor" />
          </svg>
          <span>counts</span>
        </div>
        <div class="flow-node col-start-5">
          <div class="box">
            <div class="box-bar"><span class="tag">Otherlode</span><span class="box-meta">Hosted</span></div>
            <p class="px-4 pt-4 pb-5 text-[0.9375rem] sm:px-5">Merges every instance and shows you what never ran.</p>
          </div>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_1.4fr]">
        <p>
          No release yet, so build the jar from the <a href={agentRepo} class="underline">agent's repo</a> with{' '}
          <code class="whitespace-nowrap text-[0.9em]">./gradlew build</code>.
        </p>
        <figure class="terminal min-w-0">
          <figcaption class="terminal-bar">
            <span>Run the agent</span>
            <span class="terminal-lights" aria-hidden="true"><span></span><span></span><span></span></span>
          </figcaption>
          <pre><code><span class="prompt" aria-hidden="true">$ </span>OTHERLODE_SERVICE_NAME=checkout \
  OTHERLODE_INCLUDE_PACKAGES=com.acme.checkout \
  OTHERLODE_ENDPOINT=http://&lt;your-collector&gt;:4319 \
  OTHERLODE_STATIC_BASELINE_ENABLED=true \
  java -javaagent:otherlode-agent-&lt;version&gt;.jar -jar app.jar</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <section id="security" aria-labelledby="security-title" class="scroll-mt-4">
    <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24">
      <h2 id="security-title" class="display text-[clamp(2rem,4vw,3rem)]">Security and hosting</h2>
      <div class="box mt-8">
        <div class="box-bar" aria-hidden="true"></div>
        <dl class="spec">
          {
            security.map((item) => (
              <div>
                <dt class="font-extrabold">{item.title}</dt>
                <dd class="mt-1 text-[0.9375rem] text-muted-foreground">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section aria-labelledby="access-title" class="hatched border-y-2 border-ink">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="box">
        <div class="box-bar" aria-hidden="true"></div>
        <div class="flex flex-col items-start justify-between gap-6 p-6 sm:p-7 md:flex-row md:items-center">
          <h2 id="access-title" class="display text-[clamp(1.75rem,3.4vw,2.5rem)]">We're in early access.</h2>
          <a href={earlyAccessHref} class="button shrink-0">Ask for early access</a>
        </div>
      </div>
    </div>
  </section>
</Base>
