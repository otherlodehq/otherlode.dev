---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import DocsChanges from '../../components/DocsChanges.astro';
import DocsSearch from '../../components/DocsSearch.astro';
import DocsVersionMenu from '../../components/DocsVersionMenu.astro';
import Docs from '../../layouts/Docs.astro';
import {
  changesHref,
  docsHref,
  latestHref,
  loadDocs,
  readingOrder,
  sidebarFor,
  sourceOf,
  versionedHref,
  type DocsDoc,
  type DocsSectionDocs,
} from '../../lib/docs';

/**
 * Builds the docs home, the search page, each section's changes page and
 * every docs page. A page at a section's latest version, or in a section
 * without versions, is built at `/docs/<section>/<slug>`. In a section with
 * versions, every release's pages are also built at
 * `/docs/<section>/<version>/<slug>`, so a link to one release keeps
 * working after the next. With no pages it builds nothing, so /docs does
 * not exist until it has something to show.
 */
export const getStaticPaths = (async () => {
  const all = await loadDocs();
  if (all.length === 0) return [];
  const param = (href: string) => href.slice(docsHref.length + 1);

  return [
    { params: { slug: undefined }, props: { kind: 'home' as const, all } },
    { params: { slug: 'search' }, props: { kind: 'search' as const, all } },
    ...all.flatMap((sectionDocs) => [
      ...sectionDocs.versions[0].docs.map((doc) => ({
        params: { slug: param(latestHref(doc)) },
        props: { kind: 'page' as const, all, sectionDocs, doc, pinned: false },
      })),
      ...(sectionDocs.section.versioned
        ? sectionDocs.versions.flatMap((release) =>
            release.docs.map((doc) => ({
              params: { slug: param(versionedHref(doc)) },
              props: { kind: 'page' as const, all, sectionDocs, doc, pinned: true },
            })),
          )
        : []),
      ...(sectionDocs.versions.length > 1
        ? [
            {
              params: { slug: param(changesHref(sectionDocs.section)) },
              props: { kind: 'changes' as const, all, sectionDocs },
            },
          ]
        : []),
    ]),
  ];
}) satisfies GetStaticPaths;

type Props =
  | { kind: 'home' | 'search'; all: DocsSectionDocs[] }
  | { kind: 'changes'; all: DocsSectionDocs[]; sectionDocs: DocsSectionDocs }
  | { kind: 'page'; all: DocsSectionDocs[]; sectionDocs: DocsSectionDocs; doc: DocsDoc; pinned: boolean };

const props = Astro.props as Props;
const latestSidebar = sidebarFor(props.all);

const page =
  props.kind === 'page'
    ? await (async () => {
        const { sectionDocs, doc, pinned } = props;
        const sidebar = pinned ? sidebarFor(props.all, { sectionDocs, version: doc.version! }) : latestSidebar;
        const href = pinned ? versionedHref(doc) : latestHref(doc);
        const order = readingOrder(sidebar);
        const at = order.findIndex((item) => item.href === href);
        return {
          sidebar,
          href,
          previous: order[at - 1],
          next: order[at + 1],
          rendered: await render(doc.entry),
          title: pinned ? `${doc.entry.data.title} (${doc.section.title} ${doc.version})` : doc.entry.data.title,
        };
      })()
    : undefined;
---

{
  props.kind === 'home' && (
    <Docs
      title="Docs"
      description="How to set up the Otherlode agent and collector, and how to read what Otherlode finds."
      sidebar={latestSidebar}
      currentHref={docsHref}
    >
      <h1>Docs</h1>
      {latestSidebar.map((group) => (
        <>
          <h2>
            {group.title}
            {group.version && <span class="docs-heading-version">{group.version}</span>}
          </h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
                {item.doc && <>: {item.doc.entry.data.description}</>}
              </li>
            ))}
          </ul>
        </>
      ))}
    </Docs>
  )
}

{
  props.kind === 'search' && (
    <Docs
      title="Search the docs"
      description="Search the Otherlode docs."
      sidebar={latestSidebar}
      currentHref={`${docsHref}/search`}
      index={false}
    >
      <h1>Search the docs</h1>
      <p>Search covers the latest release of each part.</p>
      <DocsSearch />
    </Docs>
  )
}

{
  props.kind === 'changes' && (
    <Docs
      title={`${props.sectionDocs.section.title} docs changes`}
      description={`What changed in the ${props.sectionDocs.section.title.toLowerCase()} docs in each release.`}
      sidebar={latestSidebar}
      currentHref={changesHref(props.sectionDocs.section)}
    >
      <p class="docs-eyebrow">{props.sectionDocs.section.title}</p>
      <h1>Docs changes</h1>
      <p>
        Each release of the {props.sectionDocs.section.title.toLowerCase()} docs, newest first, against the release
        before it.
      </p>
      <DocsChanges sectionDocs={props.sectionDocs} />
    </Docs>
  )
}

{
  props.kind === 'page' && page && (
    <Docs
      title={page.title}
      description={props.doc.entry.data.description}
      sidebar={page.sidebar}
      currentHref={page.href}
      headings={page.rendered.headings}
      index={!props.pinned}
      searchable={!props.pinned}
      pinned={props.pinned && props.doc.version !== props.sectionDocs.versions[0].version}
    >
      <p class="docs-eyebrow" data-pagefind-ignore>
        {props.doc.section.title}
      </p>
      <h1>{props.doc.entry.data.title}</h1>
      {props.doc.version && <DocsVersionMenu sectionDocs={props.sectionDocs} doc={props.doc} />}
      <page.rendered.Content />
      <footer class="docs-page-footer" data-pagefind-ignore>
        <p>
          Source: <code>{sourceOf(props.doc)}</code>
          {props.doc.version && <> at {props.doc.version}</>}
        </p>
        <nav aria-label="Previous and next page" class="docs-pager">
          {page.previous && (
            <a href={page.previous.href} rel="prev">
              Previous: {page.previous.label}
            </a>
          )}
          {page.next && (
            <a href={page.next.href} rel="next">
              Next: {page.next.label}
            </a>
          )}
        </nav>
      </footer>
    </Docs>
  )
}
