---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
---

<Base title="Request sent" description="We've got your early access request." index={false} mainClass="flex flex-col">
  <section aria-labelledby="thanks-title" class="flex flex-1 flex-col">
    <div class="mx-auto w-full max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
      <h1 id="thanks-title" class="display max-w-[40rem] text-[clamp(2.5rem,7vw,4.5rem)]">Thanks, we've got it.</h1>
      <p class="mt-5 max-w-[34rem] text-muted-foreground">We'll get back to you soon.</p>
      <p class="mt-8">
        <a href="/" class="button">Go to the homepage</a>
      </p>
    </div>
    <Ridge class="mt-auto h-16 sm:h-24 lg:h-32" />
  </section>
</Base>
