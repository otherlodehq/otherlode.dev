---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/** Props every page passes to the shared shell. */
interface Props {
  /** The page title. The site name is added unless this is the homepage. */
  title?: string;
  /** One or two sentences for search results and link previews. */
  description?: string;
  /** Set false for pages search engines should skip, such as the 404 page. */
  index?: boolean;
  /** Extra classes for the main element, such as a flex layout. */
  mainClass?: string;
}

const siteName = 'Otherlode';
const defaultDescription =
  "Otherlode finds the code your JVM services never run in production: endpoints nobody calls, methods nobody hits, branches that only go one way and classes that never load.";

const { title, description = defaultDescription, index = true, mainClass = '' } = Astro.props;
const fullTitle = title ? `${title} | ${siteName}` : `${siteName}: find the code that never runs in production`;
// With build.format 'file', the build sees paths such as /index.html and
// /privacy.html. Cloudflare Pages serves them at / and /privacy.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    {index && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ECEAE6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161412" />
    <link rel="icon" href="/otherlode-badge.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="The Otherlode badge: a bearded prospector in a miner's helmet in front of a mountain range." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-card focus:px-4 focus:py-2 focus:font-semibold"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', mainClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
