---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { docsHref, docsSearchHref, type SidebarGroup } from '../lib/docs';

/** Props for any page under /docs. */
interface Props {
  title: string;
  description: string;
  /** The sidebar's headings and links. */
  sidebar: SidebarGroup[];
  /** The URL path of the page being shown, which the sidebar marks. */
  currentHref?: string;
  /** The page's h2 and h3 headings, listed beside it on wide screens. */
  headings?: MarkdownHeading[];
  /** Set false for a page search engines should skip. */
  index?: boolean;
  /** Set true for a page the docs search should index. */
  searchable?: boolean;
  /** Set true when the page shows an older release, so the home link reads "Latest docs". */
  pinned?: boolean;
}

const {
  title,
  description,
  sidebar,
  currentHref,
  headings = [],
  index = true,
  searchable = false,
  pinned = false,
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={description} index={index}>
  <div class="docs mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <nav class="docs-sidebar" aria-label="Docs">
      <form action={docsSearchHref} method="get" role="search" class="docs-search-form">
        <label for="docs-search-sidebar" class="sr-only">Search the docs</label>
        <input id="docs-search-sidebar" name="q" type="search" placeholder="Search the docs" class="field-input" />
      </form>
      <a href={docsHref} class="docs-sidebar-home">{pinned ? 'Latest docs' : 'Docs home'}</a>
      {
        sidebar.map((group) => (
          <div>
            <h2 class="docs-sidebar-heading">
              {group.title}
              {group.version && <span class="docs-sidebar-version">{group.version}</span>}
            </h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <article class="docs-article prose" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </article>

    {
      toc.length > 0 && (
        <nav class="docs-toc" aria-label="On this page">
          <h2 class="docs-sidebar-heading">On this page</h2>
          <ul>
            {toc.map((h) => (
              <li class:list={[{ 'docs-toc-sub': h.depth === 3 }]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>
