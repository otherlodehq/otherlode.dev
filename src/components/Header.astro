---
import Wordmark from './Wordmark.astro';
import { earlyAccessHref } from '../lib/site';
---

<header class="border-b-2 border-ink">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 rounded-md no-underline">
      <img src="/otherlode-badge.svg" alt="" width="40" height="38" class="size-10" />
      <Wordmark id="header-wordmark" class="h-[1.125rem] sm:h-[1.375rem]" />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-5 text-[0.9375rem]">
        <li class="hidden sm:block"><a href="/#finds" class="no-underline hover:underline">What it finds</a></li>
        <li class="hidden sm:block"><a href="/#how" class="no-underline hover:underline">How it works</a></li>
        <li class="hidden md:block"><a href="/#security" class="no-underline hover:underline">Security</a></li>
        <li><a href={earlyAccessHref} class="button button-small whitespace-nowrap text-[0.9375rem]">Early access</a></li>
      </ul>
    </nav>
  </div>
</header>
