---
import { lettersPath, wordmarkHeight, wordmarkWidth } from '../lib/wordmark';

/**
 * The Otherlode wordmark: "otherlode" in 8-bit letters on a grey band, like
 * a line a coverage report marks as never run. The letters take the text
 * colour and the band its own colour, so both follow light and dark mode.
 * Set its height to a whole multiple of 9 pixels so each of its pixels
 * covers whole screen pixels.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['block w-auto', className]}
  viewBox={`0 0 ${wordmarkWidth} ${wordmarkHeight}`}
  width={wordmarkWidth * 3}
  height={wordmarkHeight * 3}
  shape-rendering="crispEdges"
  role="img"
  aria-label="Otherlode"
>
  <rect class="wordmark-band" width={wordmarkWidth} height={wordmarkHeight} />
  <path fill="currentColor" d={lettersPath} />
</svg>
